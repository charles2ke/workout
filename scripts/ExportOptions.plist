<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS ad-hoc export options used by the release workflow.
  For App Store distribution change `method` to `app-store`.
  Set APPLE_PROVISIONING_PROFILE secret to the base64-encoded
  .mobileprovision file that matches your signing identity.
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>ad-hoc</string>
    <key>compileBitcode</key>
    <false/>
    <key>stripSwiftSymbols</key>
    <true/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
